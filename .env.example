# Connect Four Pro - ornek ortam degiskenleri
# Bu dosyayi kopyalayip degerleri kendinize gore doldurun; gercek sifreleri git'e eklemeyin.

# Sunucu
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost/connect4
SECRET_KEY=uzun-rastgele-bir-deger
CONNECT4_HOST=0.0.0.0
CONNECT4_PORT=5000
RECONNECT_GRACE_SECONDS=30
# Hamle basina sure (saniye); dolarsa sira sendeki hukmen kaybeder. 0 = kapali (varsayilan).
# Istemciler geri sayimi gosterene kadar kapali birakin; yoksa oyuncu nedenini anlamadan yenilir
MOVE_TIME_SECONDS=0
MOVE_TIME_GRACE_SECONDS=2
DB_POOL_SIZE=20
LOG_LEVEL=INFO
# Socket.IO'ya tarayicidan baglanabilecek origin'ler (virgulle ayrilmis veya *).
# Bos birakilirsa sadece sunucunun kendi origin'i (/play) kabul edilir.
#CORS_ALLOWED_ORIGINS=https://oyun.example.com,http://localhost:5000
# Hatali giris kilidi (kullanici adi basina) ve IP basina /login + /signup siniri; 0 = kapali
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
AUTH_IP_MAX_REQUESTS=300
AUTH_IP_WINDOW_SECONDS=60

# Istemci (uzak sunucu / ngrok)
CONNECT4_SERVER=http://localhost:5000

# Testler (pytest) icin ayri bir veritabani kullanin; testler bu veritabanini temizler
TEST_DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost/connect4_test
